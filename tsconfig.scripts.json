{
  // Repository tooling that never ships in the published package: release
  // automation and other one-off Node scripts. Kept out of
  // tsconfig.server.json because that project emits into `dist/`.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["scripts"]
}
