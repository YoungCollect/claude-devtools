{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client"],

    // `@/` points at the SPA root (`src/web`), which is also Vite's `root`.
    // shadcn/ui generates components that import `@/lib/utils`, so the alias has
    // to resolve identically in tsc and in Vite — see `resolve.alias` in
    // vite.config.ts.
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/web/*"]
    }
  },
  "include": ["src/web", "src/core", "vite.config.ts"]
}
