{
  "name": "@oneyoung/claude-devtools",
  "version": "0.0.1",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Local observability proxy for Claude Code with Chat Trace and HTTP/SSE drill-down.",
  "keywords": [
    "anthropic",
    "claude",
    "claude-code",
    "devtools",
    "observability",
    "proxy",
    "sse"
  ],
  "homepage": "https://github.com/YoungCollect/agent-devtools#readme",
  "bugs": {
    "url": "https://github.com/YoungCollect/agent-devtools/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YoungCollect/agent-devtools.git"
  },
  "files": [
    "bin",
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "claude-devtools": "./bin/claude-devtools.js"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch src/server/index.ts --dev",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepack": "pnpm build",
    "start": "node bin/claude-devtools.js",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/node-server": "^1.13.7",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@pierre/diffs": "^1.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.6.14",
    "lucide-react": "^1.31.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-json-view-lite": "2.5.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "react-grab": "^0.1.50",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-react-click-to-component": "^4.2.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
