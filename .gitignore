node_modules
dist
*.log
.DS_Store
.scratch

# Generated by `pnpm preview:data` from preview/trace-preview.db. Vite copies it
# into the published bundle, so it is a build output, not a source.
preview/public/

# The built Pages site. Kept out of `dist/` because package.json's `files`
# publishes everything under `dist/` to npm, and this is a deploy artifact.
preview/dist/

# SQLite's companions are runtime state. The preview database itself is the one
# deliberately committed capture in this repository (see preview/README.md);
# these two files must never follow it in.
*.db-wal
*.db-shm

.claude
.agents
